{
  "name": "pedidos-compras-cap",
  "version": "1.0.0",
  "description": "Pedidos de Compras em SAP CAP (Node.js, JavaScript ESM)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10.1.0",
    "cds-plugin-ui5": "^0.17.0",
    "eslint": "^10.12.0",
    "local-ssl-proxy": "^2.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "prewatch": "node scripts/preparar-sqlite.js",
    "watch": "cds watch",
    "db:deploy": "cds deploy",
    "https": "local-ssl-proxy --source 8443 --target 4004",
    "test": "CDS_PLUGIN_UI5_ACTIVE=false node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "lint": "eslint .",
    "dados:demo": "node scripts/gerar-dados-demo.js"
  },
  "cds": {
    "i18n": {
      "default_language": "pt"
    },
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin": {
              "password": "admin",
              "roles": [
                "Admin"
              ]
            },
            "comum": {
              "password": "comum",
              "roles": [
                "Comum"
              ]
            },
            "*": false
          }
        }
      },
      "viacep": {
        "kind": "rest",
        "credentials": {
          "url": "https://viacep.com.br/ws"
        },
        "timeout": 5000
      },
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": "db.sqlite"
          }
        }
      },
      "[production]": {
        "db": "hana"
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/analise-clientes",
    "app/analise-estoque",
    "app/analise-pedidos",
    "app/analise-reembolsos",
    "app/gestao-clientes",
    "app/gestao-estoque",
    "app/gestao-reembolsos",
    "app/pedidos-compras"
  ]
}
