metry"/></mxCell><mxCell id="pc4e" value="&lt;b&gt;ACAO_SOMENTE_ATIVO&lt;/b&gt;&lt;br&gt;PEDIDO_EM_EDICAO ou status inválido" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#D20A0A;fillColor=#FFEAF4;fontColor=#AA0808;fontSize=11;" vertex="1" parent="pC"><mxGeometry x="286" y="543" width="216" height="64" as="geometry"/></mxCell><mxCell id="pc5" value="Dados válidos? 13–19 dígitos, validade não vencida, CVV 3–4" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#FFFFFF;fontColor=#1D2D3E;fontSize=10;spacing=6;" vertex="1" parent="pC"><mxGeometry x="30" y="640" width="220" height="90" as="geometry"/></mxCell><mxCell id="pc5e" value="&lt;b&gt;400 CARTAO_DADOS_INVALIDOS&lt;/b&gt;&lt;br&gt;diálogo continua aberto para correção" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#D20A0A;fillColor=#FFEAF4;fontColor=#AA0808;fontSize=11;" vertex="1" parent="pC"><mxGeometry x="286" y="653" width="216" height="64" as="geometry"/></mxCell><mxCell id="pc6" value="&lt;b&gt;Simula o pagamento&lt;/b&gt;&lt;br&gt;bandeira: 4 → VISA, 5 → MASTERCARD" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#EBF8FF;fontColor=#1D2D3E;fontSize=11;" vertex="1" parent="pC"><mxGeometry x="30" y="763" width="220" height="64" as="geometry"/></mxCell><mxCell id="pc7" value="Transição atômica de status aplicada? (UPDATE condicional)" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#FFFFFF;fontColor=#1D2D3E;fontSize=10;spacing=6;" vertex="1" parent="pC"><mxGeometry x="30" y="860" width="220" height="90" as="geometry"/></mxCell><mxCell id="pc7e" value="&lt;b&gt;PEDIDO_ALTERADO_CONCORRENTE&lt;/b&gt;&lt;br&gt;outra operação mudou o pedido; nada é gravado" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#D20A0A;fillColor=#FFEAF4;fontColor=#AA0808;fontSize=11;" vertex="1" parent="pC"><mxGeometry x="286" y="873" width="216" height="64" as="geometry"/></mxCell><mxCell id="pc8" value="CVV = 000?" styl