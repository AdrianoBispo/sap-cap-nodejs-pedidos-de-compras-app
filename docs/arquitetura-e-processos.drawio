&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#D20A0A;fillColor=#FFEAF4;fontColor=#AA0808;fontSize=11;" vertex="1" parent="iU"><mxGeometry x="30" y="323" width="230" height="64" as="geometry"/></mxCell><mxCell id="ic3" value="&lt;b&gt;Lê o cabeçalho e as linhas&lt;/b&gt;&lt;br&gt;colunas por sinônimo, sem acento nem caixa" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#EBF8FF;fontColor=#1D2D3E;fontSize=11;" vertex="1" parent="iC"><mxGeometry x="30" y="433" width="220" height="64" as="geometry"/></mxCell><mxCell id="ic4" value="&lt;b&gt;Valida todas as linhas antes de gravar&lt;/b&gt;&lt;br&gt;CPF, CEP, categoria, SKU, estoque, referência…" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#EBF8FF;fontColor=#1D2D3E;fontSize=11;" vertex="1" parent="iC"><mxGeometry x="30" y="543" width="220" height="64" as="geometry"/></mxCell><mxCell id="ic5" value="Alguma linha com erro?" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#FFFFFF;fontColor=#1D2D3E;fontSize=10;spacing=6;" vertex="1" parent="iC"><mxGeometry x="30" y="640" width="220" height="90" as="geometry"/></mxCell><mxCell id="iu5" value="&lt;b&gt;Nada é gravado&lt;/b&gt;&lt;br&gt;até 15 erros por linha" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#D20A0A;fillColor=#FFEAF4;fontColor=#AA0808;fontSize=11;" vertex="1" parent="iU"><mxGeometry x="30" y="653" width="230" height="64" as="geometry"/></mxCell><mxCell id="ic6" value="&lt;b&gt;Grava pelo próprio serviço&lt;/b&gt;&lt;br&gt;mesmas regras da tela: ViaCEP, SKU, reserva" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#EBF8FF;fontColor=#1D2D3E;fontSize=11;" vertex="1" parent="iC"><mxGeometry x="30" y="763" width="220" height="64" as="geometry"/></mxCell><mxCell id="id6" value="&lt;b&gt;Clientes · Itens · Pedidos&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;si