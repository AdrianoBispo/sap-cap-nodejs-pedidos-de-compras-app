ntColor=#475E75;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1130" y="370" width="320" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="importacao" name="9. Importação por planilha"><mxGraphModel adaptiveColors="auto" grid="0" page="1" pageWidth="1560" pageHeight="1480"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="i_tit" value="9. Importação em massa por planilha" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#0070F2;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="40" as="geometry"/></mxCell><mxCell id="i_sub" value="Tudo ou nada: todas as linhas são validadas antes de gravar e qualquer erro cancela a importação inteira." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#475E75;" vertex="1" parent="1"><mxGeometry x="0" y="38" width="1200" height="40" as="geometry"/></mxCell><mxCell id="iU" value="Usuário · List Report (Clientes, Estoque, Pedidos)" style="swimlane;startSize=70;html=1;whiteSpace=wrap;collapsible=0;strokeColor=#475E75;fillColor=#EDEFF0;swimlaneFillColor=#FFFFFF;fontColor=#1D2D3E;fontStyle=1;fontSize=12;align=left;spacingLeft=64;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="290" height="1310" as="geometry"/></mxCell><mxCell id="iUi" value="" style="shape=umlActor;html=1;outlineConnect=0;strokeColor=#475E75;fillColor=#FFFFFF;" vertex="1" parent="iU"><mxGeometry x="22" y="12" width="24" height="46" as="geometry"/></mxCell><mxCell id="iC" value="Serviço da app · action importarPlanilha (SAP CAP)" style="swimlane;startSize=70;html=1;whiteSpace=wrap;collapsible=0;strokeColor=#0070F2;fillColor=#D1EFFF;swimlaneFillColor=#FAFDFF;fontColor=#0040B0;fontStyle=1;fontSize=12;align=left;spacingLeft=64;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="520" height="1310" as="geometry"/></mxCell><mxCell