nded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vagu" target="vfin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ve5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vfin" target="vfim1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ve6" value="Cancelar (com motivo)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vabe" target="vcan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ve7" value="Cancelar com pagamento aprovado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="vagu" target="vpro"><mxGeometry relative="1" as="geometry"><mxPoint x="-90" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="ve8" value="Reembolso rejeitado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="vpro" target="vagu"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="ve9" value="Reembolso aprovado" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vpro" target="vcan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ve10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="vcan" target="vfim2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="vn" value="&lt;b&gt;Ações por status&lt;/b&gt;&lt;br&gt;ABERTO: Editar (só itens), Efetuar Pagamento, Cancelar&lt;br&gt;AGUARDANDO_APROVACAO: Aprovar pedido, Cancelar (abre reembolso)&lt;br&gt;PROCESSANDO_REEMBOLSO, FINALIZADO e CANCELADO: nenhuma ação&lt;br&gt;O pedido registrado nunca é excluído: é cancelado.&lt;br&gt;Toda ação começa por uma transição atômica de status; se outra operação mudou o pedido: PEDIDO_ALTERADO_CONCORRENTE.&lt;br&gt;Ação sobre o rascunho: ACAO_SOMENTE_ATIVO (HTTP 409)." style="shape=note;size=14;whiteSpace=wrap;html=1;strokeColor=#D5DADD;fillColor=#FFFFFF;fontColor=#475E75;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="870" y="590" width="560" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="registro" name="4. Registro do pedido"><mxGraphModel adaptiveColors="auto" grid="0" page="1" pageWidth="1540" pageHeight="1590"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="r_tit" value="4. Registro do pedido (rascunho → Salvar)" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#0070F2;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="40" as="geometry"/></mxCell><mxCell id="r_sub" value="Do rascunho ao pedido ABERTO: o usuário informa só o cliente e os itens; preços, totais, número, status e reserva de estoque ficam com o backend." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#475E75;" vertex="1" parent="1"><mxGeometry x="0" y="38" width="1200" height="