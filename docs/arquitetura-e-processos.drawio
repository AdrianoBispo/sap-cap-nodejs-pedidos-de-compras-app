l><mxCell id="re17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rc8" target="rd8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="rC" source="rc8" target="rc9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re19" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="rC" source="rc9" target="rc9e"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re20" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="rc9" target="ru10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="re21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="rU" source="ru10" target="rf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="rn0" value="&lt;b&gt;Edição do pedido ABERTO&lt;/b&gt;&lt;br&gt;Editar → alterar itens → Salvar. O backend compara com a reserva atual: reserva o acréscimo e libera o excedente e os itens removidos. Itens que já estavam no pedido mantêm o preço fixado. O cliente é imutável (PEDIDO_CLIENTE_IMUTAVEL). O Save da edição só ajusta a reserva se o pedido continua ABERTO (transição atômica)." style="shape=note;size=14;whiteSpace=wrap;html=1;strokeColor=#D5DADD;fillColor=#FFFFFF;fontColor=#475E75;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1130" y="190" width="320" height="190" as="geometry"/></mxCell><mxCell id="rn1" value="&lt;b&gt;Transação única&lt;/b&gt;&lt;br&gt;Qualquer erro desfaz número, reservas e totais: não há reserva dupla nem parcial." style="shape=note;size=14;whiteSpace=wrap;html=1;strokeColor=#D5DADD;fillColor=#FFFFFF;fontColor=#475E75;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1130" y="410" width="320" height="110" as="geometry"/></mxCell><mxCell id="rn2" value="&lt;b&gt;Importação de pedidos&lt;/b&gt;&lt;br&gt;A importação por planilha usa o mesmo registro (validações e reserva)." style="shape=note;size=14;whiteSpace=wrap;html=1;strokeColor=#D5DADD;fillColor=#FFFFFF;fontColor=#475E75;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1130" y="550" width="320" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pagamento" name="5. Efetuar Pagamento"><mxGraphModel adaptiveColors="auto" grid="0" page="1" pageWidth="1740" pageHeight="1700"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p_tit" value="5. Efetuar Pagamento (pagamento simulado)" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#0070F2;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="40" as="geometry"/></mxCell><mxCell id="p_sub" value="Diálogo próprio com sap.m.MaskInput (o diálogo padrão do Fiori Elements não tem máscara) chamando a action vinculada PedidosService.efetuarPagamento (regras em srv/lib/pedidos)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#475E75;" vertex="1" parent="1"><mxGeometry x="0" y="38" width="1200" height="40" as="geometry"/></mxCell><mxCell id="pU" value="Usuário · app Pedidos de Compras (diálogo com máscara)" style="swimlane;startSize=70;html=1;whiteSpace=wrap;collapsible=0