oundColor=#FFFFFF;" edge="1" parent="1" source="cr6" target="cj6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="cR" source="ca5" target="ck7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="cR" source="cj6" target="ck7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce19" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ck7" target="cr7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce20" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="cR" source="ck7" target="ck8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce21" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="cR" source="ck8" target="ck9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ce22" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475E75;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1D2D3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="cR" source="ck8" target="ck8n"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="cn0" value="&lt;b&gt;Decisão única&lt;/b&gt;&lt;br&gt;A decisão é gravada com UPDATE ... WHERE statusReembolso = PENDENTE; de duas decisões simultâneas, a segunda recebe REEMBOLSO_STATUS_INVALIDO. A decisão registra data e usuário." style="shape=note;size=14;whiteSpace=wrap;html=1;strokeColor=#D5DADD;fillColor=#FFFFFF;fontColor=#475E75;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1650" y="190" width="300" height="150" as="geometry"/></mxCell><mxCell id="cn1" value="&lt;b&gt;Transição atômica&lt;/b&gt;&lt;br&gt;O pedido só muda de status se continua como foi lido; senão, PEDIDO_ALTERADO_CONCORRENTE (srv/lib/pedidos)." style="shape=note;size=14;whiteSpace=wrap;html=1;strokeColor=#D5DADD;fillColor=#FFFFFF;fontColor=#475E75;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1650" y="370" width="300" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cep" name="8. Endereço e CEP"><mxGraphModel adaptiveColors="auto" grid="0" page="1" pageWidth="1540" pageHeight="1590"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="e_tit" value="8. Endereço do cliente: consulta de CEP" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#0070F2;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="40" as="geometry"/></mxCell><mxCell id="e_sub" value="Ao informar o CEP o backend preenche o endereço, reaproveitando CEPs já validados ou consultando o ViaCEP." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#475E75;" vertex="1" parent="1"><mxGeometry x="0" y="38" width="1200" height="40" as="geometry"/></mxCell><mxCell id="eU" value="Usuário Admin · app Gestão de Clientes" style="swimlane;startSize=70;html=1;whiteSpace=wrap;collapsible=0;strokeColor=#475E75;fillColor=#EDEFF0;swimlaneFillColor=#FFFFFF;fontColor=#1D2D3E;fontStyle=1;fontSize=12;align=left;spacingLeft=64;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="290" height="1420" as="geometry"/></mxCell><mxCell id="eUi" value="" style="shape=umlActor;html=1;outlineConnect=0;strokeColor=#475E75;fillColor=#FFFFFF;" vertex="1" parent="eU"><mxGeometry x="22" y="12" width="24" height="46" as="geometry"/></mxCell><mxCell id="eC" value="ClientesService (SAP CAP)" style="swimlane;startSize=70;html=1;whiteSpace=wrap;collapsible=0;strokeColor=#0070F2;fillColor=#D1EFFF;swimlaneFillColor=#FAFDFF;fontColor=#0040B0;fontStyle=1;fontSize=12;align=left;spacingLeft=64;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="520" height="1420" as="geometry"/></mxCell><mxCell id="eCi" value="" style="shape=mxgraph.sap.icon;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeWidth=1;strokeColor=#D5DADD;fillColor=#EDEFF0;gradientColor=#FCFCFC;gradientDirection=west;aspect=fixed;html=1;SAPIcon=SAP_Cloud_Application_Programming_Model;" vertex="1" parent="eC"><mxGeometry x="10" y="12" width="46" height="46" as="geometry"/></mxCell><mxCell id="eX" value="API ViaCEP (serviço externo)" style="swimlane;startSize=70;html=1;whiteSpace=wrap;collapsible=0;strokeColor=#475E75;fillColor=#F5F6F7;swimlaneFillColor=#FFFFFF;fontColor=#475E75;fontStyle=1;fontSize=12;align=left;spacingLeft=64;" vertex="1" parent="1"><mxGeometry x="810" y="90" width="290" height="1420" as="geometry"/></mxCell><mxCell id="es" value="" style="ellipse;html=1;fillColor=#0070F2;strokeColor=none;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="eU"><mxGeometry x="120" y="115" width="40" height="40" as="geometry"/></mxCell><mxCell id="eu1" value="&lt;b&gt;Editar cliente (rascunho)&lt;/b&gt;&lt;br&gt;incluir endereço" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#475E75;fillColor=#FFFFFF;fontColor=#1D2D3E;fontSize=11;" vertex="1" parent="eU"><mxGeometry x="30" y="213" width="230" height="64" as="geometry"/></mxCell><mxCell id="eu2" value="&lt;b&gt;Informar o CEP&lt;/b&gt;" style="rounded=1;arc