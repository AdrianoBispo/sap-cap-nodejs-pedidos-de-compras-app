<mvc:View
    controllerName="analisecompras.controller.Dashboard"
    displayBlock="true"
    height="100%"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:ac="analisecompras.control"
    xmlns:mvc="sap.ui.core.mvc">
    <f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{i18n>appTitle}" />
                </f:heading>
                <f:content>
                    <Select
                        id="domainSelect"
                        visible="{device>/narrow}"
                        selectedKey="{state>/domain}"
                        change=".onDomainSelect"
                        items="{state>/domains}">
                        <core:Item key="{state>key}" text="{state>text}" />
                    </Select>
                    <SegmentedButton
                        id="domainButton"
                        visible="{= !${device>/narrow}}"
                        selectedKey="{state>/domain}"
                        selectionChange=".onDomainChange"
                        items="{state>/domains}">
                        <items>
                            <SegmentedButtonItem key="{state>key}" text="{state>text}" icon="{state>icon}" width="8.5rem" />
                        </items>
                    </SegmentedButton>
                </f:content>
                <f:actions>
                    <Button
                        text="{i18n>openManage}"
                        tooltip="{state>/manageTooltip}"
                        icon="sap-icon://action"
                        type="Transparent"
                        press=".onOpenManage" />
                    <Button
                        icon="sap-icon://refresh"
                        tooltip="{i18n>refresh}"
                        type="Transparent"
                        press=".onRefresh" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <FlexBox id="filterBox" wrap="Wrap" alignItems="End" class="pcFilterBox" />
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox class="sapUiResponsiveContentPadding">
                <MessageStrip
                    text="{state>/loadError}"
                    visible="{= !!${state>/loadError}}"
                    type="Error"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />
                <Title text="{i18n>kpiTitle}" level="H3" class="sapUiTinyMarginBottom" />
                <FlexBox renderType="Bare" class="pcKpis sapUiSmallMarginBottom" items="{state>/kpis}">
                    <VBox class="pcKpi">
                        <Label text="{state>label}" />
                        <Title text="{state>value}" titleStyle="H2" class="pcKpiValue" />
                    </VBox>
                </FlexBox>
                <Title text="{i18n>chartsTitle}" level="H3" class="sapUiTinyMarginBottom" />
                <FlexBox renderType="Bare" class="pcCards" items="{state>/cards}">
                    <f:Card>
                        <f:header>
                            <card:Header
                                title="{state>title}"
                                subtitle="{state>subtitle}"
                                press=".onCardPress" />
                        </f:header>
                        <f:content>
                            <ac:AnalysisChart
                                chartType="{state>chart}"
                                dimensionLabel="{state>dimensionLabel}"
                                measures="{state>measures}"
                                rows="{state>rows}"
                                busy="{state>busy}"
                                noDataText="{i18n>noData}" />
                        </f:content>
                    </f:Card>
                </FlexBox>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
