<mvc:View
    controllerName="analisecompras.controller.Detail"
    displayBlock="true"
    height="100%"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    xmlns:ac="analisecompras.control"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc">
    <f:DynamicPage id="page" headerExpanded="true" toggleHeaderOnTitleClick="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:breadcrumbs>
                    <Breadcrumbs currentLocationText="{detail>/title}">
                        <Link text="{detail>/domainText}" press=".onNavBack" />
                    </Breadcrumbs>
                </f:breadcrumbs>
                <f:heading>
                    <Title text="{detail>/title}" />
                </f:heading>
                <f:snappedContent>
                    <Text text="{detail>/subtitle}" />
                </f:snappedContent>
                <f:expandedContent>
                    <Text text="{detail>/subtitle}" />
                </f:expandedContent>
                <f:actions>
                    <Button
                        icon="sap-icon://refresh"
                        tooltip="{i18n>refresh}"
                        type="Transparent"
                        press=".onRefresh" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <FlexBox id="filterBox" wrap="Wrap" alignItems="End" class="pcFilterBox" />
            </f:DynamicPageHeader>
        </f:header>
        <f:content>
            <VBox class="sapUiResponsiveContentPadding">
                <MessageStrip
                    text="{detail>/error}"
                    visible="{= !!${detail>/error}}"
                    type="Error"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />
                <f:Card>
                    <f:header>
                        <card:Header title="{detail>/title}" subtitle="{detail>/subtitle}">
                            <card:toolbar>
                                <OverflowToolbar>
                                    <SegmentedButton
                                        selectedKey="{detail>/chart}"
                                        selectionChange=".onChartTypeChange"
                                        items="{detail>/chartTypes}"
                                        tooltip="{i18n>chartType}">
                                        <items>
                                            <SegmentedButtonItem
                                                key="{detail>key}"
                                                icon="{detail>icon}"
                                                tooltip="{detail>text}"
                                                enabled="{detail>enabled}" />
                                        </items>
                                    </SegmentedButton>
                                </OverflowToolbar>
                            </card:toolbar>
                        </card:Header>
                    </f:header>
                    <f:content>
                        <ac:AnalysisChart
                            chartType="{detail>/chart}"
                            dimensionLabel="{detail>/dimensionLabel}"
                            measures="{detail>/measures}"
                            rows="{detail>/rows}"
                            height="26rem"
                            busy="{detail>/busy}"
                            noDataText="{i18n>noData}" />
                    </f:content>
                </f:Card>
                <Table
                    id="table"
                    class="sapUiSmallMarginTop"
                    items="{detail>/tableRows}"
                    busy="{detail>/busy}"
                    sticky="ColumnHeaders"
                    noDataText="{i18n>noData}">
                    <headerToolbar>
                        <OverflowToolbar>
                            <Title text="{i18n>detailTable}" level="H3" />
                            <ToolbarSpacer />
                            <Text text="{detail>/countText}" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column>
                            <Text text="{detail>/dimensionLabel}" />
                        </Column>
                        <Column hAlign="End">
                            <Text text="{detail>/header1}" />
                        </Column>
                        <Column hAlign="End" visible="{detail>/hasSecond}">
                            <Text text="{detail>/header2}" />
                        </Column>
                        <Column hAlign="End" visible="{detail>/hasShare}">
                            <Text text="{i18n>share}" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <customData>
                                <core:CustomData key="total" value="{= ${detail>total} ? 'true' : 'false' }" writeToDom="true" />
                            </customData>
                            <cells>
                                <Text text="{detail>label}" />
                                <Text text="{detail>value1}" />
                                <Text text="{detail>value2}" />
                                <Text text="{detail>share}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
