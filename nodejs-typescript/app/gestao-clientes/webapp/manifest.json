{
  "_version": "2.0.0",
  "sap.app": {
    "id": "gestaoclientes",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.28.0",
      "toolsId": "1519f979-d3b6-4e41-a47b-26f84108ff69"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/clientes/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Cliente-manage": {
          "semanticObject": "Cliente",
          "action": "manage",
          "title": "{{appTitle}}",
          "subTitle": "{{appDescription}}",
          "icon": "sap-icon://customer",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.12",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "gestaoclientes.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties",
        "settings": {
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ClientesList",
          "target": "ClientesList"
        },
        {
          "pattern": "Clientes({key}):?query:",
          "name": "ClientesObjectPage",
          "target": "ClientesObjectPage"
        },
        {
          "pattern": "Clientes({key})/enderecos({key2}):?query:",
          "name": "EnderecosObjectPage",
          "target": "EnderecosObjectPage"
        }
      ],
      "targets": {
        "ClientesList": {
          "type": "Component",
          "id": "ClientesList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Clientes",
              "variantManagement": "Page",
              "navigation": {
                "Clientes": {
                  "detail": {
                    "route": "ClientesObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "importarPlanilha": {
                      "press": "gestaoclientes.ext.ImportarPlanilha.abrir",
                      "visible": "{= %{/Permissoes/somenteLeitura} === false}",
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>importarPlanilha}"
                    }
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "ClientesObjectPage": {
          "type": "Component",
          "id": "ClientesObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Clientes",
              "navigation": {
                "enderecos": {
                  "detail": {
                    "route": "EnderecosObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "enderecos/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "creationMode": {
                      "name": "NewPage"
                    }
                  }
                }
              }
            }
          }
        },
        "EnderecosObjectPage": {
          "type": "Component",
          "id": "EnderecosObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Clientes/enderecos",
              "content": {
                "header": {
                  "actions": {
                    "DataFieldForAction::ClientesService.definirEnderecoPrincipal": {
                      "visible": "{= %{/Permissoes/somenteLeitura} === false}"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
