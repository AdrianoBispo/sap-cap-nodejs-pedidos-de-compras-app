{
  "_version": "2.0.0",
  "sap.app": {
    "id": "pedidoscompras",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.28.0",
      "toolsId": "1ddd3c9e-8c51-40fb-b6cb-c7a422317221"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/pedidos/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "PedidoCompra-manage": {
          "semanticObject": "PedidoCompra",
          "action": "manage",
          "title": "{{appTitle}}",
          "subTitle": "{{appDescription}}",
          "icon": "sap-icon://sales-order",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.12",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ui.unified": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "pedidoscompras.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties",
        "settings": {
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "PedidosList",
          "target": "PedidosList"
        },
        {
          "pattern": "Pedidos({key}):?query:",
          "name": "PedidosObjectPage",
          "target": "PedidosObjectPage"
        },
        {
          "pattern": "Pedidos({key})/itens({key2}):?query:",
          "name": "ItensPedidoObjectPage",
          "target": "ItensPedidoObjectPage"
        },
        {
          "pattern": "Pedidos({key})/itensSnapshot({key2}):?query:",
          "name": "PedidosItensSnapshotsObjectPage",
          "target": "PedidosItensSnapshotsObjectPage"
        }
      ],
      "targets": {
        "PedidosList": {
          "type": "Component",
          "id": "PedidosList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Pedidos",
              "variantManagement": "Page",
              "navigation": {
                "Pedidos": {
                  "detail": {
                    "route": "PedidosObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "importarPlanilha": {
                      "press": "pedidoscompras.ext.ImportarPlanilha.abrir",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>importarPlanilha}"
                    }
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "PedidosObjectPage": {
          "type": "Component",
          "id": "PedidosObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Pedidos",
              "navigation": {
                "itens": {
                  "detail": {
                    "route": "ItensPedidoObjectPage"
                  }
                },
                "itensSnapshot": {
                  "detail": {
                    "route": "PedidosItensSnapshotsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "itens/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "creationMode": {
                      "name": "InlineCreationRows"
                    }
                  }
                },
                "itensSnapshot/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "selectionMode": "None"
                  }
                }
              }
            }
          }
        },
        "ItensPedidoObjectPage": {
          "type": "Component",
          "id": "ItensPedidoObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Pedidos/itens"
            }
          }
        },
        "PedidosItensSnapshotsObjectPage": {
          "type": "Component",
          "id": "PedidosItensSnapshotsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Pedidos/itensSnapshot"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
