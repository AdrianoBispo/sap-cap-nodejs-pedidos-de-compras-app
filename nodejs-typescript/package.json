{
  "name": "pedidos-compras-cap-ts",
  "version": "1.0.0",
  "description": "Pedidos de Compras em SAP CAP (Node.js, TypeScript ESM) - porte do projeto RAP ZAVBS_PC",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10.1.0",
    "@types/node": "^24.0.0",
    "cds-plugin-ui5": "^0.17.0",
    "eslint": "^10.12.0",
    "local-ssl-proxy": "^2.0.5",
    "tsx": "^4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds-tsx watch",
    "https": "local-ssl-proxy --source 8443 --target 4004",
    "serve": "cds-tsx serve",
    "typer": "cds-typer \"*\" --outputDirectory @cds-models",
    "typecheck": "npm run typer && tsc --noEmit",
    "pretest": "npm run typer",
    "test": "CDS_TYPESCRIPT=tsx CDS_PLUGIN_UI5_ACTIVE=false node --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "lint": "eslint . && npm run typecheck",
    "build": "cds build --production",
    "dados:demo": "tsx scripts/gerar-dados-demo.ts"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "i18n": {
      "default_language": "pt"
    },
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "admin": {
              "password": "admin",
              "roles": [
                "Admin"
              ]
            },
            "comum": {
              "password": "comum",
              "roles": [
                "Comum"
              ]
            },
            "*": false
          }
        }
      },
      "viacep": {
        "kind": "rest",
        "credentials": {
          "url": "https://viacep.com.br/ws"
        },
        "timeout": 5000
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/analise-clientes",
    "app/analise-estoque",
    "app/analise-pedidos",
    "app/analise-reembolsos",
    "app/gestao-clientes",
    "app/gestao-estoque",
    "app/gestao-reembolsos",
    "app/pedidos-compras"
  ]
}
